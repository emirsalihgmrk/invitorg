# Neon: pooled connection (the host contains "-pooler"), used by the app
DATABASE_URL=
# Neon: direct connection, used by drizzle-kit migrations
DATABASE_URL_UNPOOLED=

# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google Cloud > APIs & Services > Clients (redirect: /api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Leave empty to print emails to the console
RESEND_API_KEY=
EMAIL_FROM="Invitorg <onboarding@resend.dev>"

# iyzico sandbox: sandbox-merchant.iyzipay.com > Settings > Merchant Settings
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
